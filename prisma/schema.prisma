generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OpportunityStage {
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  FINALIZED
  CLOSED_LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  EVENT
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ExpenseStatus {
  PENDING
  PROCESSED
  VERIFIED
  REJECTED
}

enum RecurrenceType {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum DeboursNoteStatus {
  DRAFT
  SENT
  PAID
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  passwordHash       String
  googleRefreshToken String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  contacts           Contact[]
  opportunities      Opportunity[]   @relation("OpportunityOwner")
  activities         Activity[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  companiesOwned     Company[]       @relation("CompanyOwner")
  expenses           Expense[]
  recurringExpenses  RecurringExpense[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Company {
  id         String     @id @default(cuid())
  name       String
  domain     String?
  // Axonaut / CRM enrichissements
  externalRef       String?   @unique
  isIndividual      Boolean   @default(false)
  addressStreet     String?
  addressZip        String?
  addressCity       String?
  addressCountry    String?
  siret             String?   @unique
  siren             String?   // Numéro SIREN (9 chiffres) - de l'API Sirene
  codeNAF           String?   // Code NAF/APE - de l'API Sirene
  libelleNAF        String?   // Libellé de l'activité NAF - de l'API Sirene
  vatNumber         String?
  iban              String?
  bic               String?
  rum               String?
  sepaMandateActive Boolean?
  legacyCode        String?
  locale            String?
  notes             String?
  // Intégrations externes
  tiimeId              String?
  googleDriveFolderId  String?
  tags              Tag[]
  statusClient      Boolean   @default(false)
  statusProspect    Boolean   @default(false)
  statusSupplier    Boolean   @default(false)
  owner             User?     @relation("CompanyOwner", fields: [ownerId], references: [id])
  ownerId           String?
  linkedinUrl       String?
  salesNavigatorUrl String?
  firstInvoiceDate  DateTime?
  lastInvoiceDate   DateTime?
  turnoverAllTime   Decimal?  @db.Decimal(18, 2)
  turnoverThisYear  Decimal?  @db.Decimal(18, 2)
  lastActivityAt    DateTime?
  nextActivityAt    DateTime?
  contacts   Contact[]
  opportunities Opportunity[]
  quotes     Quote[]
  expenses   Expense[]
  deboursNotes DeboursNote[]
  recurringExpenses RecurringExpense[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Contact {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String?
  email        String?       @unique
  phone        String?
  mobilePhone  String?
  title        String?
  jobTitle     String?
  industry     String?
  linkedinUrl  String?
  funnelStep   String?
  externalRef  String?       @unique
  company      Company?      @relation(fields: [companyId], references: [id])
  companyId    String?
  owner        User?         @relation(fields: [ownerId], references: [id])
  ownerId      String?
  opportunities Opportunity[]
  activities   Activity[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Opportunity {
  id          String           @id @default(cuid())
  title       String
  stage       OpportunityStage @default(QUALIFICATION)
  amount      Float?
  closeDate   DateTime?
  expectedPaymentDate DateTime?
  taxRate     Decimal?         @db.Decimal(5, 4) // Taux de taxe (0.27 pour 27%)
  contact     Contact?         @relation(fields: [contactId], references: [id])
  contactId   String?
  company     Company?         @relation(fields: [companyId], references: [id])
  companyId   String?
  owner       User?            @relation("OpportunityOwner", fields: [ownerId], references: [id])
  ownerId     String?
  activities  Activity[]
  quotes      Quote[]
  payments    Payment[]
  expenses    Expense[]
  deboursNotes DeboursNote[]
  recurringExpenses RecurringExpense[]
  // Intégrations externes
  googleDriveFolderId String?
  tiimeQuoteId        String?
  quoteUrl            String?
  tiimeInvoiceIds     String[]   @db.Text
  invoiceUrls         String[]   @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Activity {
  id             String        @id @default(cuid())
  type           ActivityType  @default(TASK)
  subject        String
  description    String?
  dueDate        DateTime?
  contact        Contact?      @relation(fields: [contactId], references: [id])
  contactId      String?
  opportunity    Opportunity?  @relation(fields: [opportunityId], references: [id])
  opportunityId  String?
  user           User?         @relation(fields: [userId], references: [id])
  userId         String?
  googleEventId  String?   @unique
  googleCalendarId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Webhook {
  id        String   @id @default(cuid())
  url       String
  event     String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  createdAt DateTime @default(now())
}

model ImportJob {
  id        String        @id @default(cuid())
  filename  String
  status    ImportStatus  @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String?   @unique
  companies Company[]
}

model Quote {
  id                String        @id @default(cuid())
  label             String        // Libellé du devis
  quoteNumber       String?       // Numéro de devis (auto-généré ou manuel)
  issueDate         DateTime      // Date d'émission
  validityEndDate   DateTime?     // Date de fin de validité
  freeField         String?       // Champ libre
  status            QuoteStatus   @default(DRAFT)
  totalHT           Decimal?      @db.Decimal(18, 2)
  totalTTC          Decimal?      @db.Decimal(18, 2)
  // Relations
  opportunity       Opportunity?  @relation(fields: [opportunityId], references: [id])
  opportunityId     String?
  company           Company?      @relation(fields: [companyId], references: [id])
  companyId         String?       // Peut être lié directement à l'entreprise
  // Intégrations externes
  tiimeQuoteId      String?       // ID du devis dans Tiime (si créé via Make)
  quoteUrl          String?       // URL du devis (PDF, etc.)
  items             QuoteItem[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model QuoteItem {
  id                String   @id @default(cuid())
  label             String   // Libellé de la ligne
  description       String?  // Description détaillée
  quantity          Decimal  @db.Decimal(18, 2)
  unit              String   // Unité (heures, unités, jours, etc.)
  unitPriceHT       Decimal  @db.Decimal(18, 2) // Prix unitaire HT
  discountAmount    Decimal? @db.Decimal(18, 2) // Montant de remise
  taxRate           Decimal  @db.Decimal(5, 4) // Taux TVA (0.2 pour 20%, 0.1 pour 10%, etc.)
  vatExemptionReason String? // Motif d'exonération TVA
  totalHT           Decimal  @db.Decimal(18, 2) // Total HT de la ligne (calculé)
  order             Int      // Ordre d'affichage
  // Relations
  quote             Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId           String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Expense {
  id                String        @id @default(cuid())
  // Informations extraites
  supplierName      String?       // Nom du fournisseur
  invoiceNumber     String?       // Numéro de facture
  invoiceDate       DateTime?     // Date de la facture
  amountHT          Decimal?      @db.Decimal(18, 2) // Montant HT
  amountTTC         Decimal?      @db.Decimal(18, 2) // Montant TTC
  vatAmount         Decimal?      @db.Decimal(18, 2) // Montant TVA
  vatRate           Decimal?      @db.Decimal(5, 4)  // Taux TVA (0.2 pour 20%)
  // Fichier source
  fileUrl           String?       // URL du fichier (PDF/image)
  fileName          String?       // Nom du fichier original
  fileType          String?       // Type (pdf, jpg, png)
  // Données brutes de l'OCR
  rawOcrData        Json?         // Données brutes extraites par l'IA
  // Comptabilité
  accountCode       String?       // Code compte comptable
  accountLabel      String?       // Libellé du compte
  // Statut et validation
  status            ExpenseStatus @default(PENDING)
  notes             String?
  // Dépenses récurrentes
  isForecast        Boolean       @default(false) // Indique si c'est une dépense prévisionnelle
  forecastDate      DateTime?     // Date prévisionnelle de paiement
  recurringExpense  RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  recurringExpenseId String?      // Lien vers le modèle récurrent
  // Relations
  company           Company?      @relation(fields: [companyId], references: [id])
  companyId         String?       // Fournisseur lié (si trouvé)
  user              User?         @relation(fields: [userId], references: [id])
  userId            String?       // Utilisateur qui a uploadé
  opportunity       Opportunity?  @relation(fields: [opportunityId], references: [id])
  opportunityId     String?       // Opportunité liée
  deboursNotes      DeboursNote[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Payment {
  id            String      @id @default(cuid())
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId String?
  deboursNote   DeboursNote? @relation(fields: [deboursNoteId], references: [id], onDelete: Cascade)
  deboursNoteId String?
  amount        Decimal     @db.Decimal(18, 2) // Montant payé
  paymentDate   DateTime    @default(now()) // Date de paiement réel
  taxRate       Decimal     @db.Decimal(5, 4) @default(0.27) // Taux de taxe appliqué
  taxAmount     Decimal     @db.Decimal(18, 2) // Montant des taxes (calculé)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model TreasuryBalance {
  id        String   @id @default(cuid())
  date      DateTime @unique // Date du solde (unique)
  balance   Decimal  @db.Decimal(18, 2) // Solde à cette date
  isManual  Boolean  @default(false) // true si modifié manuellement
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeboursNote {
  id                  String            @id @default(cuid())
  title               String            // Titre de la note de débours
  issueDate           DateTime          @default(now()) // Date d'émission
  expectedPaymentDate DateTime?         // Date prévisionnelle de paiement
  totalAmount         Decimal           @db.Decimal(18, 2) // Montant total TTC
  status              DeboursNoteStatus @default(DRAFT) // Statut : Brouillon, Envoyée, Payée
  googleDocId         String?           // ID du document Google Docs créé
  googleDocUrl        String?           // URL du document Google Docs
  notes               String?           // Notes additionnelles
  // Relations
  opportunity         Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId       String
  company             Company?          @relation(fields: [companyId], references: [id])
  companyId           String?           // Client destinataire
  expenses            Expense[]         // Dépenses incluses dans la note
  payments            Payment[]         // Paiements reçus pour cette note
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model RecurringExpense {
  id                String          @id @default(cuid())
  // Informations de la dépense
  supplierName      String?         // Nom du fournisseur
  amountHT          Decimal?        @db.Decimal(18, 2) // Montant HT
  amountTTC         Decimal?        @db.Decimal(18, 2) // Montant TTC
  vatAmount         Decimal?        @db.Decimal(18, 2) // Montant TVA
  vatRate           Decimal?        @db.Decimal(5, 4)  // Taux TVA
  // Comptabilité
  accountCode       String?         // Code compte comptable
  accountLabel       String?         // Libellé du compte
  // Récurrence
  recurrenceType    RecurrenceType  @default(MONTHLY) // Type de récurrence
  paymentDay        Int             // Jour du mois pour le paiement (1-31)
  startDate         DateTime        // Date de début de la récurrence
  endDate           DateTime?       // Date de fin optionnelle
  isActive          Boolean         @default(true) // Pour activer/désactiver
  notes             String?         // Notes additionnelles
  // Relations
  company           Company?        @relation(fields: [companyId], references: [id])
  companyId         String?         // Fournisseur lié
  user              User?           @relation(fields: [userId], references: [id])
  userId            String?          // Utilisateur propriétaire
  opportunity       Opportunity?    @relation(fields: [opportunityId], references: [id])
  opportunityId     String?         // Opportunité liée
  expenses          Expense[]       // Dépenses générées à partir de ce modèle
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}
